# Copier dans .env.local puis remplir.
OPENAI_API_KEY=
# Code d'accès exigé par les routes API (recommandé dès que le site est public). Ouvrir l'appli avec ?code=...
MURMURE_CODE=
# 1 = réponses simulées, sans appel à OpenAI
MURMURE_MOCK=0
# Options
# Palier de vitesse du conteur. Mesuré : « fast » (prix x2) donne 1,5 s, « ultrafast » (prix x6) 1,3 s,
# normal 2,1 s. « fast » est le meilleur compromis coût et vitesse.
# SOL_SERVICE_TIER=fast
# Niveau de réflexion du conteur (banc d'essai : « low » est le plus rapide et le plus juste)
# SOL_EFFORT=low
# JUDGE_MODE=sol            # forcer le plan B si la Decisions API est refusée
# TTS_MODE=navigateur       # forcer la voix du téléphone
# TTS_VOICE=marin
